# このファイルを .env にコピーして値を入れる。.env はGit管理外。値をチャットやコミットに書かない。

# Notion のインテグレーション（読み取り専用）のシークレット
NOTION_TOKEN=

# Notion のデータソースID（「健康記録」「睡眠セッション」）
NOTION_HEALTH_DATA_SOURCE_ID=
NOTION_SLEEP_SESSION_DATA_SOURCE_ID=

# 閲覧用の合言葉（12文字以上。暗号文は公開されるので、推測されにくい長い言葉にする）
SITE_PASSPHRASE=

# ActivityWatch 集計プロジェクトの場所（省略時は C:\Project\ActivityWarch）
# ACTIVITYWATCH_PROJECT=
